#!/bin/bash
# iLO2's remote console is an in-browser Java <applet> needing NPAPI, so it runs
# in Firefox 52 ESR (last NPAPI release) with the IcedTea Java plugin. Log in,
# then Remote Console tab -> the applet loads inline. Runs on the display the
# launch listener assigns (:1).
# Usage: ilo2 <ilo-ip>
IP="${1:?usage: ilo2 <ilo-ip>}"
export DISPLAY="${DISPLAY:-:1}"
PROFILE=/root/.ff52-ilo
mkdir -p "$PROFILE"

# Open maximized (fills the display). A fresh profile otherwise starts at a
# small default size, leaving black borders around the window in the noVNC view.
[ -f "$PROFILE/xulstore.json" ] || printf '%s' \
  '{"chrome://browser/content/browser.xul":{"main-window":{"screenX":"0","screenY":"0","width":"1280","height":"1024","sizemode":"maximized"}}}' \
  > "$PROFILE/xulstore.json"

# No certificate exception is baked in: every iLO2 has its own self-signed
# cert. On first launch accept it once on Firefox's warning page (Advanced ->
# Add Exception, "Permanently store"); Firefox writes cert_override.txt into
# this profile, which lives on the ilo-profile volume and survives rebuilds.
# If the iLO's certificate changes, delete that file and accept once again.

# Kiosk: this browser only ever talks to the BMC, so hide all chrome (URL bar,
# tabs, menu) and disable the session/crash-restore nag. Rewritten each launch.
mkdir -p "$PROFILE/chrome"
printf '%s\n' \
  '#nav-bar, #TabsToolbar, #toolbar-menubar, #PersonalToolbar { visibility: collapse !important; }' \
  > "$PROFILE/chrome/userChrome.css"
printf '%s\n' \
  'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);' \
  'user_pref("browser.sessionstore.resume_from_crash", false);' \
  'user_pref("browser.sessionstore.max_resumed_crashes", 0);' \
  'user_pref("toolkit.startup.max_resumed_crashes", -1);' \
  > "$PROFILE/user.js"

exec /opt/firefox52/firefox --no-remote --profile "$PROFILE" "https://$IP"
